{
  "name": "clockwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck:client --workspace @clockwork/panel",
    "clockwork": "tsx packages/cli/src/bin.ts",
    "check:public": "node scripts/check-public-files.mjs",
    "check": "npm run typecheck && npm test && npm run check:public",
    "build": "npm run build --workspace @clockwork/panel",
    "panel:dev": "npm run dev --workspace @clockwork/panel",
    "pet:desktop": "npm run start --workspace @clockwork/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgacetinkaya/clockwork.git"
  },
  "bugs": {
    "url": "https://github.com/tolgacetinkaya/clockwork/issues"
  },
  "description": "Task-driven AI teams with durable events, verification, and budget tracking.",
  "engines": {
    "node": ">=24"
  }
}
